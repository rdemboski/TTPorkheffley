<Window x:Class="TTPHLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TTPHLauncher.ViewModels"
        xmlns:views="clr-namespace:TTPHLauncher.Views"
        Title="Toontown Porkheffley"
        Width="900" Height="560"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <!-- DataTemplates: WPF auto-selects the right UserControl for each ViewModel type -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RegisterViewModel}">
            <views:RegisterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PatcherViewModel}">
            <views:PatcherView/>
        </DataTemplate>
    </Window.Resources>

    <!-- Outer border provides the rounded window + drop shadow -->
    <Border CornerRadius="10" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="4" Opacity="0.6"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>   <!-- Custom title bar -->
                <RowDefinition Height="*"/>    <!-- Content area -->
            </Grid.RowDefinitions>

            <!-- Window background gradient -->
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0E1E42" Offset="0"/>
                    <GradientStop Color="#071228" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- ============================================================
                 Custom title bar — draggable, minimize, close
            ============================================================ -->
            <Border Grid.Row="0"
                    Background="#0A1630"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0">
                    <!-- App name -->
                    <TextBlock Text="Toontown Porkheffley"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="12"
                               VerticalAlignment="Center"/>

                    <!-- Window buttons (right-aligned) -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <Button Content="—"
                                Command="{Binding MinimizeCommand}"
                                Width="32" Height="28"
                                Foreground="{StaticResource BrushTextSecondary}"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="14"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Root" Background="Transparent"
                                            CornerRadius="4" Width="32" Height="28">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="#1A2D55"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Content="✕"
                                Command="{Binding CloseCommand}"
                                Width="32" Height="28"
                                Foreground="{StaticResource BrushTextSecondary}"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="12"
                                Cursor="Hand"
                                Margin="2,0,0,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Root" Background="Transparent"
                                            CornerRadius="4" Width="32" Height="28">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="#C0392B"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================
                 Content area — ContentControl swaps views via DataTemplates
            ============================================================ -->
            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentView}"
                            Focusable="False"/>

        </Grid>
    </Border>
</Window>
