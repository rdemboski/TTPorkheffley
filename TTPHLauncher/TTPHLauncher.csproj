<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TTPHLauncher</RootNamespace>
    <AssemblyName>TTPHLauncher</AssemblyName>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- Uncomment once you add an icon file:
    <ApplicationIcon>Resources\launcher.ico</ApplicationIcon> -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Source-generated MVVM: ObservableObject, [ObservableProperty], [RelayCommand] -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy launcher.json next to the exe so LauncherConfig.Load() finds it -->
    <Content Include="icon.ico" />
    <Content Include="launcher.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
