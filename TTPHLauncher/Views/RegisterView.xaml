<UserControl x:Class="TTPHLauncher.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- ================================================================
             LEFT — decorative panel
        ================================================================ -->
        <Grid Grid.Column="0" Margin="44,0,20,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Join the"
                           Foreground="{StaticResource BrushTextSecondary}"
                           FontSize="28"
                           FontWeight="Light"/>
                <TextBlock Text="Tooniverse"
                           Foreground="{StaticResource BrushAccent}"
                           FontSize="40"
                           FontWeight="Black"
                           Margin="0,-4,0,20"/>
                <TextBlock TextWrapping="Wrap"
                           Foreground="{StaticResource BrushTextSecondary}"
                           FontSize="13"
                           LineHeight="22"
                           MaxWidth="280">
                    Create your free account to start playing Toontown Porkheffley.
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- ================================================================
             RIGHT — registration form
        ================================================================ -->
        <Border Grid.Column="1"
                Background="{StaticResource BrushSurface}"
                Padding="36,36">

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="Create account"
                           Foreground="{StaticResource BrushTextPrimary}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,0,0,24"/>

                <!-- Username -->
                <TextBlock Text="USERNAME" Style="{StaticResource Label}"/>
                <TextBox Style="{StaticResource InputBox}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12"/>

                <!-- Email -->
                <TextBlock Text="EMAIL" Style="{StaticResource Label}"/>
                <TextBox Style="{StaticResource InputBox}"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12"/>

                <!-- Password -->
                <TextBlock Text="PASSWORD" Style="{StaticResource Label}"/>
                <PasswordBox x:Name="PasswordBox"
                             Style="{StaticResource InputPassword}"
                             PasswordChanged="PasswordBox_PasswordChanged"
                             Margin="0,0,0,12"/>

                <!-- Confirm Password -->
                <TextBlock Text="CONFIRM PASSWORD" Style="{StaticResource Label}"/>
                <PasswordBox x:Name="ConfirmPasswordBox"
                             Style="{StaticResource InputPassword}"
                             PasswordChanged="ConfirmPasswordBox_PasswordChanged"
                             Margin="0,0,0,20"/>

                <!-- Error message -->
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource BrushError}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}"/>

                <!-- Success message -->
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource BrushSuccess}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVis}}"/>

                <!-- Register button -->
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding RegisterCommand}">
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Create Account"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Text" Value="Creating account…"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <!-- Back to login link -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,16,0,0">
                    <TextBlock Text="Already have an account?  "
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <Button Content="Sign in"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding GoToLoginCommand}"/>
                </StackPanel>

            </StackPanel>
        </Border>

    </Grid>
</UserControl>
