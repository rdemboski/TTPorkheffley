<UserControl x:Class="TTPHLauncher.Views.PatcherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="40,32,40,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header: game name + sign out -->
            <RowDefinition Height="*"/>      <!-- Center: news / filler -->
            <RowDefinition Height="Auto"/>   <!-- Footer: patcher + play button -->
        </Grid.RowDefinitions>

        <!-- ================================================================
             HEADER
        ================================================================ -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Toontown Porkheffley"
                           Foreground="{StaticResource BrushAccent}"
                           FontSize="26"
                           FontWeight="Black"/>
                <TextBlock Text="Private Server"
                           Foreground="{StaticResource BrushTextSecondary}"
                           FontSize="14"
                           FontWeight="Light"
                           Margin="0,-2,0,0"/>
            </StackPanel>

            <!-- Sign out link (top-right) -->
            <Button Content="Sign out"
                    Style="{StaticResource DangerGhostButton}"
                    Command="{Binding SignOutCommand}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"/>
        </Grid>

        <!-- ================================================================
             MIDDLE — placeholder for news / announcements
             (Replace with a WebView2 or styled ListBox later)
        ================================================================ -->
        <Border Grid.Row="1"
                Margin="0,24,0,24"
                Background="{StaticResource BrushSurface}"
                CornerRadius="8"
                Padding="24,20">
            <StackPanel>
                <TextBlock Text="News &amp; Announcements"
                           Foreground="{StaticResource BrushTextPrimary}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12"/>
                <TextBlock Foreground="{StaticResource BrushTextSecondary}"
                           FontSize="13"
                           LineHeight="22"
                           TextWrapping="Wrap">
                    Welcome to Toontown Porkheffley! This is a custom private server.
                    Check back here for updates, events, and patch notes.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ================================================================
             FOOTER — patcher status + play button
        ================================================================ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>    <!-- Patcher status / bars -->
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="160"/>  <!-- Play button -->
            </Grid.ColumnDefinitions>

            <!-- Patcher panel -->
            <StackPanel Grid.Column="0" VerticalAlignment="Bottom">

                <!-- Overall progress -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="12"
                               Margin="8,0,0,0">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0:0}%">
                                <Binding Path="OverallProgress"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Grid>

                <ProgressBar Value="{Binding OverallProgress}"
                             Maximum="100"
                             Style="{StaticResource GameProgressBar}"
                             Margin="0,0,0,8"/>

                <!-- Per-file progress bar (only visible while downloading a specific file) -->
                <ProgressBar Value="{Binding FileProgress}"
                             Maximum="100"
                             Style="{StaticResource GameProgressBar}"
                             Visibility="{Binding IsPatching, Converter={StaticResource BoolToVis}}"/>

                <!-- Error state -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,8,0,0"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{StaticResource BrushError}"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                    <Button Content="Retry"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding RetryPatchCommand}"
                            Margin="12,0,0,0"
                            FontSize="12"/>
                </StackPanel>

            </StackPanel>

            <!-- PLAY button -->
            <Button Grid.Column="2"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding PlayCommand}"
                    Height="52"
                    FontSize="18"
                    FontWeight="Bold">
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="PLAY!"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPatching}" Value="True">
                                    <Setter Property="Text" Value="Updating…"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Text" Value="PLAY!"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>

        </Grid>

    </Grid>
</UserControl>
